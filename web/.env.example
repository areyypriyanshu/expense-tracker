# Canonical origin, used for canonical URLs, OpenGraph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Raises the GitHub API rate limit for the build-time release fetch
# from 60 requests/hour anonymous to 5000 requests/hour authenticated.
# Only needs public read access. Without it the build falls back to the
# committed snapshot in lib/releases.snapshot.json.
GITHUB_TOKEN=

# Used only by scripts/publish.mjs, never by the site itself. Needs
# "contents: write" on areyypriyanshu/expense-tracker.
# GITHUB_TOKEN=

# Feedback form. Both are required for /feedback to accept anything; without
# them the page renders a "not switched on yet" state and /api/feedback answers
# 503 rather than failing on submit.
#
# RESEND_API_KEY: from resend.com/api-keys, starts with re_
# FEEDBACK_TO_EMAIL: where feedback is delivered. This must be the address the
#   Resend account was created with, because the shared onboarding sender
#   domain can only deliver to that one address and returns a 403 otherwise.
# FEEDBACK_FROM_EMAIL: optional. Defaults to Resend's onboarding domain. Set it
#   to a verified domain of your own to send from that instead.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
# FEEDBACK_FROM_EMAIL=Expense Tracker <feedback@yourdomain.com>