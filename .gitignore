# Build artifacts
bin/
gen/
out/
build/
.gradle/
.kotlin/

# Room's exported schema JSON is generated from the @Database version.
# It is intentionally NOT ignored: schemas are the record of how the DB
# evolved and are what migration tests are written against.
# (If it ever starts appearing untracked, add:
#   ksp { arg("room.schemaLocation", "$projectDir/schemas") } to app/build.gradle.kts
#   and commit app/schemas/ deliberately, rather than ignoring the output.)

# Packaged APKs / bundles produced by a local release build
*.apk
*.aab

# Native build output (CameraX and ML Kit pull in native libraries)
.externalNativeBuild/
.cxx/

# ── Website (web/) ────────────────────────────────────────────────────────
# Dependencies and build output. The screenshots under web/public/screens/
# are deliberately NOT ignored: they are committed, because they are the real
# captures the site serves and a fresh clone should render without an emulator.
# For the same reason lib/releases.snapshot.json is committed: it is the
# fallback the site renders when the GitHub API is unreachable during a build.
web/node_modules/
web/.next/
web/out/
web/.turbo/
web/.vercel/
web/next-env.d.ts

# Local environment. .env.example IS committed, since it is the template that
# documents which variables the site reads.
web/.env.local
web/.env*.local

# Test and type-check caches
web/*.tsbuildinfo
web/coverage/
web/test-results/
web/playwright-report/

# Nothing under web/storage should ever be committed: that is where a
# self-hosted instance would keep uploaded files, and it is generated.
web/storage/

# Heap dumps from an OOM or a debugger session
*.hprof

# IDE settings
.idea/
*.iml
*.iws
*.ipr

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Local configuration
local.properties

# Sensitive information and keys
*.jks
*.keystore
*.p12
*.key
*.pem
secrets.properties
signing.properties
*.env
.env.*

# Captures and logs
captures/
*.log

# Leftovers from a rejected patch
*.orig
*.rej

# Project specific exclusions
expense_tracker_markdown_pack/
.opencode/
.claude/
AGENTS.md
graphify-out/

# Local Gradle cache
.gradle_home/

# Local OCR test files
receipts/
IndianReceiptDataset/

# Temporary OCR debug script
run_ocr.ps1

# Local Room database copies exported for debugging
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
