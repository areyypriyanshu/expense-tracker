<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive financial data from cloud backups -->
        <include domain="database" path="." />
        <exclude domain="database" path="expense_database" />
        <exclude domain="database" path="expense_database-wal" />
        <exclude domain="database" path="expense_database-shm" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="upi_sync_prefs.xml" />
        <exclude domain="sharedpref" path="secure_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow database transfer between user's own devices -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="upi_sync_prefs.xml" />
        <exclude domain="sharedpref" path="secure_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
